# Optional AI generation. Keep real keys private and server-side.
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1/chat/completions
OPENAI_MODEL=gpt-4o-mini
AI_API_TIMEOUT=45
PORT=5000
FLASK_DEBUG=0

# Optional image generation settings (provider support and billing vary)
OPENAI_IMAGE_API_URL=https://api.openai.com/v1/images/generations
OPENAI_IMAGE_MODEL=gpt-image-1
\n# Generate a strong random value for sessions; never commit production secrets.\nFLASK_SECRET_KEY=replace_with_a_long_random_secret\n# Set to 1 behind HTTPS in production.\nCOOKIE_SECURE=0\nDB_PATH=creator.db
# Optional audio transcription endpoint/model (OpenAI-compatible)
OPENAI_TRANSCRIPTION_API_URL=https://api.openai.com/v1/audio/transcriptions
OPENAI_TRANSCRIPTION_MODEL=whisper-1
